# Job Radar scanner — copy to backend/.env for local runs (never commit the real file).
# In GitHub Actions the same names come from repository secrets / variables (see .github/workflows/job-fetch.yml).

# --- Supabase (required for `run`; `probe` works without) -------------------------------
# Project Settings → API. The service_role key bypasses RLS — keep it secret, server side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Email digest -----------------------------------------------------------------------
# smtp | resend | none   (empty = auto: resend if RESEND_API_KEY, smtp if SMTP_USER+SMTP_PASSWORD, else none)
EMAIL_PROVIDER=
# Gmail: turn on 2-Step Verification, then create an App Password (Google Account → Security → App passwords)
SMTP_HOST=smtp.gmail.com
# 465 = SSL, 587 = STARTTLS
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
# or https://resend.com (free tier) — the "from" domain must be verified there
RESEND_API_KEY=
# default: "Job Radar <SMTP_USER>" (smtp) / "Job Radar <onboarding@resend.dev>" (resend)
EMAIL_FROM=
# used when search_criteria.email_to is empty; comma separated for several recipients
EMAIL_TO=

# Site root (or the tracker page) — the email's "Open Job Radar" button links to <SITE_URL>/tracker/
SITE_URL=https://your-user.github.io/Portfolio/

# --- Run behaviour ----------------------------------------------------------------------
# schedule | manual | local  (stored on the fetch_runs row)
RUN_TRIGGER=local
# true = read only: no database writes, no email
DRY_RUN=false
# companies scanned in parallel
MAX_WORKERS=6
# seconds per HTTP request
REQUEST_TIMEOUT=20
# max detail pages fetched per company for list-only APIs (Workday ×2, SmartRecruiters, Workable)
ENRICH_LIMIT=40
# seconds one company may take before the scanner gives up on it (retried next run)
COMPANY_TIME_BUDGET=240
# seconds after which companies that have not started yet are skipped (the Actions job timeout is 25 min)
RUN_TIME_BUDGET=780
# print company names, job titles, criteria and addresses. Empty = on for local runs, off in GitHub
# Actions — a public repository's Actions logs are public (see backend/README.md → Privacy)
LOG_DETAILS=
