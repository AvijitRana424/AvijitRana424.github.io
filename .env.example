# Copy to .env.local for local dev. Leave empty to run in DEMO mode (data kept in your browser).
# Both values are safe to expose publicly — Row Level Security protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# The only account allowed to upload a resume / use the tracker (must match supabase/schema.sql is_owner()).
VITE_OWNER_EMAIL=ranaavijit80@gmail.com
# owner/repo — used for the "Run scan now" link in the tracker (GitHub Actions page).
VITE_GITHUB_REPO=
